{
  "installCommand": "sed -i '/node-linker/d' ../../.npmrc && sed -i '/package-import-method/d' ../../.npmrc && cd ../.. && pnpm install",
  "buildCommand": "./node_modules/.bin/tsc -b && ./node_modules/.bin/vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
